<?php

/**
 * @file
 * Attaches CookieConsent to public Drupal pages.
 */

/**
 * Implements hook_page_attachments().
 */
function brendigo_cookieconsent_page_attachments(array &$attachments): void {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }
  $settings = \Drupal::config('brendigo_cookieconsent.settings');
  if (!$settings->get('enabled')) {
    return;
  }

  $languages = ['auto', 'hr', 'en', 'de', 'it', 'es', 'fr', 'ar'];
  $positions = ['bottom-center', 'bottom-left', 'bottom-right', 'bottom-bar',
    'top-center', 'top-left', 'top-right', 'top-bar', 'center'];
  $lang = (string) ($settings->get('language') ?: 'auto');
  $position = (string) ($settings->get('position') ?: 'bottom-center');
  $policy = (string) ($settings->get('policy_url') ?: '/politika-kolacica');

  $attachments['#attached']['library'][] = 'brendigo_cookieconsent/consent';
  $attachments['#attached']['drupalSettings']['brendigoCookieConsent'] = [
    'language' => in_array($lang, $languages, TRUE) ? $lang : 'auto',
    'position' => in_array($position, $positions, TRUE) ? $position : 'bottom-center',
    'revision' => mb_substr((string) ($settings->get('revision') ?: '1'), 0, 40),
    'consentDays' => max(1, min(365, (int) ($settings->get('consent_days') ?: 180))),
    'policyUrl' => preg_match('~^(https?://|/(?!/))~i', $policy) ? $policy : '/politika-kolacica',
    'accentColor' => preg_match('/^#[a-f0-9]{6}$/i', (string) $settings->get('accent_color'))
      ? $settings->get('accent_color') : '#4357e8',
  ];
}
